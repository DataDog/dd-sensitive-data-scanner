[
  {
    "id": "bitrise_access_token",
    "pattern": "(?:^|\\\\[rn]|[\\s=:(\\[{\"'<])(?<sds_match>bitpat_[A-Za-z0-9_-]{86}_[A-Za-z0-9]{6})(?:$|[\\s)\\]}\"'>&]|\\\\[rn])",
    "pattern_capture_groups": [
      "sds_match"
    ],
    "default_included_keywords": [],
    "validator": {
      "type": "ChainedStepValidator",
      "default_response": "pass",
      "config": {
        "version": 1,
        "steps": [
          {
            "name": "payload_and_checksum",
            "comment": "the CRC covers `bitpat_<body>`, without the `_` before the checksum",
            "op": "Split",
            "input": {
              "param": "$GLOBAL_MATCH",
              "separator": "_",
              "occurrence": -1
            },
            "output": {
              "before": "payload",
              "after": "embedded"
            }
          },
          {
            "name": "verify",
            "comment": "base62 is compared by value; the rule regex pins the 6-character width",
            "op": "VerifyChecksum",
            "input": {
              "payload": "$payload",
              "embedded": "$embedded",
              "alg": "crc32",
              "scheme": "base62"
            }
          }
        ]
      }
    },
    "positive": [
      {
        "description": "valid Bitrise Access Token ignoring keyword",
        "input_base64": "aGVsbG8gd29ybGQsIGNvbm5lY3RlZCB3aXRoIGJpdHBhdF9ScjcwcnU4WGNieW1KSXdvcWNTSGd4VUdVRVZrVGFzWF9td1dJN0huWXM3eGZheER6M0FtY0tzaHV0Q09TX1F5am5XT2xqZG53UHlNLS1sYW9XQmNVd180WUNBVmU=",
        "output": "hello world, connected with [REDACTED]",
        "use_included_keywords": false
      },
      {
        "description": "valid Bitrise Access Token in curl command",
        "input_base64": "Y3VybCAtSCAiQXV0aG9yaXphdGlvbiBiaXRwYXRfQ1FTOEhRUmZOaUlrRlh5YlJnNnR2RWQyNHJSY2lSR2paMTlrMm5ic1FqbWUzRERuQjJ5T1lrR0pXVm5HSkFqOUlqUnA4SWVWTmpPWVBSd0xCSWRmTVFfNERDMEs4IiBodHRwczovL2FwaS5iaXRyaXNlLmlvL3YwLjEvbWU=",
        "output": "curl -H \"Authorization [REDACTED]\" https://api.bitrise.io/v0.1/me",
        "use_included_keywords": false
      }
    ],
    "negative": [
      {
        "description": "invalid pattern for Bitrise Access Token (forbidden character in body)",
        "input_base64": "Yml0cGF0X1JyNzBydThYY2J5bUpJd29xY1NIZ3hVR1VFVmtUYXNYX213V0k3SG5Zczd4ZmF4RHozQW1jS3NodXRDT1NfUXlqbldPbGpkbndQeU0tLWxhb1dCY1V3XzRZQ0FWIQ==",
        "rejected_by": "pattern",
        "use_included_keywords": false
      },
      {
        "description": "invalid pattern for Bitrise Access Token (truncated body)",
        "input_base64": "Yml0cGF0X1JyNzBydThYY2J5bUpJd29xY1NIZ3hVR1VFVmtUYXNYX213V0k3SG5Zczd4ZmF4RHozQW1jS3NodXRDT1NfUXlqbldPbGpkbndQeU0=",
        "rejected_by": "pattern",
        "use_included_keywords": false
      },
      {
        "description": "invalid pattern for Bitrise Access Token (wrong prefix)",
        "input_base64": "Yml0d3JvbmdfUnI3MHJ1OFhjYnltSkl3b3FjU0hneFVHVUVWa1Rhc1hfbXdXSTdIbllzN3hmYXhEejNBbWNLc2h1dENPU19ReWpuV09samRud1B5TS0tbGFvV0JjVXdfNFlDQVZl",
