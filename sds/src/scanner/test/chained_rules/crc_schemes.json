      {
        "description": "valid access token standalone",
        "input_base64": "Y2ZsdHZmeFdvdTQ0N1l4SXVnUVVsOFZ4dGIwNDcxMnFxUkowdzY1aExuMGh1aDFzc1dYOW9zejk4b1g4Vlp2UQ==",
        "output": "[REDACTED]",
