  {
    "id": "zuplo_api_key",
    "pattern": "(?:^|\\\\[rn]|[\\s=:(\\[{\"'<])(?<sds_match>zpka_[a-f0-9]{32}_[a-f0-9A-F]{8})(?:$|[\\s)\\]}\"'>&]|\\\\[rn])",
    "pattern_capture_groups": [
      "sds_match"
    ],
    "default_included_keywords": [],
    "validator": {
      "type": "ChainedStepValidator",
      "default_response": "pass",
      "config": {
        "version": 1,
        "steps": [
          {
            "name": "head_and_checksum",
            "op": "Split",
            "input": {
              "param": "$GLOBAL_MATCH",
              "separator": "_",
              "occurrence": -1
            },
            "output": {
              "before": "head",
              "after": "embedded"
            }
          },
          {
            "name": "body",
            "comment": "the CRC covers the body only, not the `zpka_` prefix",
            "op": "Split",
            "input": {
              "param": "$head",
              "separator": "_",
              "occurrence": 0
            },
            "output": {
              "after": "body"
            }
          },
          {
            "name": "verify",
            "comment": "hex decoding accepts the upper-case checksums the rule regex allows",
            "op": "VerifyChecksum",
            "input": {
              "payload": "$body",
              "embedded": "$embedded",
              "alg": "crc32",
              "scheme": "hex"
            }
          }
        ]
      }
    },
    "positive": [
      {
        "description": "valid Zuplo API key 1",
        "input_base64": "QXV0aG9yaXphdGlvbjogQmVhcmVyIHpwa2FfNDcyY2ZkYWUwNGM5NGVkMjkxYWRlZWFhOGJjZDAxMjFfNjY2MmI4OGE=",
        "output": "Authorization: Bearer [REDACTED]",
        "use_included_keywords": false
      },
      {
        "description": "valid Zuplo API key 2 in quotes",
        "input_base64": "a2V5ID0gInpwa2FfN2UyYzE3ZTgzOGQ4NDYyYWI2NzEzMjBhNzI3ZGUyZTVfN2UwNGEyMzgi",
        "output": "key = \"[REDACTED]\"",
        "use_included_keywords": false
      },
      {
        "description": "valid Zuplo API key 3 alone",
        "input_base64": "enBrYV9hZWRkMTFlZTEzMmM0ZWEzYjAyMDA2ZmQwYzE3ODM2OV9lNzY0ZWYxYg==",
        "output": "[REDACTED]",
        "use_included_keywords": false
      }
    ],
    "negative": [
      {
        "description": "forbidden non-hex character in body",
        "input_base64": "enBrYV80NzJjZmRhZTA0Yzk0ZWQyOTFhZGVlYWE4YmNkMDEyZ182NjYyYjg4YQ==",
        "rejected_by": "pattern",
        "use_included_keywords": false
      },
      {
        "description": "key embedded in a longer word is not matched",
        "input_base64": "eHpwa2FfNDcyY2ZkYWUwNGM5NGVkMjkxYWRlZWFhOGJjZDAxMjFfNjY2MmI4OGE=",
        "rejected_by": "pattern",
        "use_included_keywords": false
      },
      {
        "description": "truncated suffix",
        "input_base64": "enBrYV80NzJjZmRhZTA0Yzk0ZWQyOTFhZGVlYWE4YmNkMDEyMV82NjYyYjg=",
        "rejected_by": "pattern",
        "use_included_keywords": false
      },
      {
        "description": "wrong prefix",
        "input_base64": "enBrYl80NzJjZmRhZTA0Yzk0ZWQyOTFhZGVlYWE4YmNkMDEyMV82NjYyYjg4YQ==",
        "rejected_by": "pattern",
        "use_included_keywords": false
      }
    ]
  },
  {
    "id": "grafana_service_account_token",
    "pattern": "\\bgl[a-z]{2}_[0-9a-zA-Z]{32}_[0-9a-f]{8}\\b",
    "default_included_keywords": [],
    "validator": {
      "type": "ChainedStepValidator",
      "default_response": "pass",
      "config": {
        "version": 1,
        "steps": [
          {
            "name": "payload_and_checksum",
            "op": "Split",
            "input": {
              "param": "$GLOBAL_MATCH",
              "separator": "_",
              "occurrence": -1
            },
            "output": {
              "before": "payload",
              "after": "embedded"
            }
          },
          {
            "name": "verify",
            "op": "VerifyChecksum",
            "input": {
              "payload": "$payload",
              "embedded": "$embedded",
              "alg": "crc32",
              "scheme": "hex",
              "endian": "little"
            }
          }
        ]
      }
    },
    "positive": [
      {
        "description": "valid oauth secret key",
        "input_base64": "aGVsbG8gd29ybGQsIGNvbm5lY3RlZCB3aXRoIGdsc2FfWEJXM3c0MnN5Wm1kTmN6WHk3UnQ5d3pQdlNtemozY05fZjg3NTAxZGU=",
