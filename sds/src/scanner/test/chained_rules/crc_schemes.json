  },
  {
    "id": "confluent_api_secret",
    "pattern": "(?:^|\\\\[rn]|[\\s=:(\\[{\"'<])(?<sds_match>cflt[A-Za-z0-9+/]{60})(?:$|[\\s)\\]}\"'>&]|\\\\[rn])",
    "pattern_capture_groups": [
      "sds_match"
    ],
    "default_included_keywords": [],
    "validator": {
      "type": "ChainedStepValidator",
      "default_response": "pass",
      "config": {
        "version": 1,
        "steps": [
          {
            "name": "body",
            "op": "Extract",
            "input": {
              "param": "$GLOBAL_MATCH",
              "slice": "[4:58]"
            },
            "output": "body"
          },
          {
            "name": "embedded",
            "op": "Extract",
            "input": {
              "param": "$GLOBAL_MATCH",
              "slice": "[58:]"
            },
            "output": "embedded"
          },
          {
            "name": "verify",
            "op": "VerifyChecksum",
            "input": {
              "payload": "$body",
              "embedded": "$embedded",
              "alg": "crc32",
              "scheme": "base64_nopad",
              "endian": "little"
            }
          }
        ]
      }
    },
    "positive": [
      {
        "description": "valid access token containing a slash and a plus in its body",
        "input_base64": "Y2ZsdHRXQWxkYy9kME9FQ3U1Nzd3NlhwVnFKdzB0aVN3M3lDL2k0bklxSUhLY1ZDSDZMK212SlpGMzc2RmJhQQ==",
        "output": "[REDACTED]",
        "use_included_keywords": false
      },
      {
