[
  {
    "id": "github_access_token",
    "pattern": "\\bgh[opsu]_[0-9a-zA-Z]{36}\\b",
    "default_included_keywords": [
      "access",
      "github",
      "token"
    ],
    "hand_written_validator": {
      "type": "GithubTokenChecksum"
    },
    "validator": {
      "type": "ChainedStepValidator",
      "default_response": "pass",
      "config": {
        "version": 1,
        "steps": [
          {
            "name": "last_part",
            "op": "Split",
            "input": {
              "param": "$GLOBAL_MATCH",
              "separator": "_",
              "occurrence": -1
            },
            "output": {
              "after": "last"
            }
          },
          {
            "name": "body_and_checksum",
            "comment": "GithubTokenChecksum requires base62 only and more than 6 characters",
            "op": "RegexMatch",
            "input": {
              "param": "$last",
              "pattern": "(?<body>[A-Za-z0-9]+)(?<checksum>[A-Za-z0-9]{6})"
            },
            "captures": {
              "body": "body",
              "checksum": "checksum"
            }
          },
          {
            "name": "verify",
            "op": "VerifyChecksum",
            "input": {
              "payload": "$body",
              "embedded": "$checksum",
              "alg": "crc32",
              "scheme": "base62"
            }
          }
        ]
      }
    },
    "positive": [
      {
        "description": "Valid Github Access Token to be scrubbed",
        "input_base64": "MjAyMi0wMi0yMiAxNDowOTowNyw3MDEgSU5GTyByZXF1ZXN0OiB7aWQ9MTIzLCBnaXRodWJfYWNjZXNzX3Rva2VuPWdocF95TFZleVBhbXR5NWRiNFpESFV6eVd1aGppSTBBZ2kzR1dUZmJ9",
        "output": "2022-02-22 14:09:07,701 INFO request: {id=123, github_access_token=[REDACTED]}",
        "use_included_keywords": false
      }
    ],
    "negative": [
      {
        "description": "Invalid Github Access Token - invalid checksum",
        "input_base64": "MjAyMi0wMi0yMiAxNDowOTowNyw3MDEgSU5GTyByZXF1ZXN0OiB7aWQ9MTIzLCBnaXRodWJfYWNjZXNzX3Rva2VuPWdocF95TFZleVBhbXR5NWRiNFpESFV6eVd1aGppSTBBZ2kzR1dUZmN9",
        "rejected_by": "validator",
        "use_included_keywords": false
      },
      {
        "description": "Invalid Github Access Token - missing prefix",
        "input_base64": "MjAyMi0wMi0yMiAxNDowOTowNyw3MDEgSU5GTyByZXF1ZXN0OiB7aWQ9MTIzLCBnaXRodWJfYWNjZXNzX3Rva2VuPXJhbl95TFZleVBhbXR5NWRiNFpESFV6eVd1aGppSTBBZ2kzR1dUZmJ9",
        "rejected_by": "pattern",
        "use_included_keywords": false
      }
    ]
  },
