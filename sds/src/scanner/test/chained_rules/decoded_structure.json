  {
    "id": "aws_bedrock_long-term_api_key",
    "pattern": "(?:^|\\\\[rn]|[\\s=:(\\[{\"'<])(?<sds_match>ABSK[A-Za-z0-9+/]{120,}={0,2})(?:$|[\\s)\\]}\"'>&]|\\\\[rn])",
    "pattern_capture_groups": [
      "sds_match"
    ],
    "default_included_keywords": [],
    "validator": {
      "type": "ChainedStepValidator",
      "default_response": "pass",
      "config": {
        "version": 1,
        "steps": [
          {
            "name": "encoded",
            "op": "Extract",
            "input": {
              "param": "$GLOBAL_MATCH",
              "slice": "[4:]"
            },
            "output": "encoded"
          },
          {
            "name": "decoded",
            "op": "Decode",
            "input": {
              "param": "$encoded",
              "scheme": "base64"
            },
            "output": "decoded"
          },
          {
            "name": "structure",
            "comment": "`<IAM user name>-at-<AWS account id>:<secret>`; IAM user names use `[A-Za-z0-9+=,.@_-]`",
            "op": "RegexMatch",
            "input": {
              "param": "$decoded",
              "pattern": "[A-Za-z0-9+=,.@_-]{1,64}-at-[0-9]{12}:[!-~]+"
            }
          }
        ]
      }
    },
