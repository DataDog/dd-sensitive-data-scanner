[
  {
    "id": "polar_authorization_code",
    "pattern": "\\b(?<sds_match>polar_ac_[A-Za-z0-9]{43})\\b",
    "pattern_capture_groups": [
      "sds_match"
    ],
    "default_included_keywords": [],
    "validator": {
      "type": "ChainedStepValidator",
      "default_response": "pass",
      "config": {
        "version": 1,
        "steps": [
          {
            "name": "last_part",
            "op": "Split",
            "input": {
              "param": "$GLOBAL_MATCH",
              "separator": "_",
              "occurrence": -1
            },
            "output": {
              "after": "last"
            }
          },
          {
            "name": "body",
            "op": "Extract",
            "input": {
              "param": "$last",
              "slice": "[:-6]"
            },
            "output": "body"
          },
          {
            "name": "embedded",
            "op": "Extract",
            "input": {
              "param": "$last",
              "slice": "[-6:]"
            },
            "output": "embedded"
          },
          {
            "name": "verify",
            "comment": "base62 is compared by value; the rule regex pins the 6-character width",
            "op": "VerifyChecksum",
            "input": {
              "payload": "$body",
              "embedded": "$embedded",
              "alg": "crc32",
              "scheme": "base62"
            }
          }
        ]
      }
    },
    "positive": [
      {
        "description": "valid Polar authorization code",
        "input_base64": "aHR0cHM6Ly9leGFtcGxlLmNvbS9jYj9jb2RlPXBvbGFyX2FjX0tXMlhQMVJwRXNDck9VdGQ1WjBjN2haMGdtY1Q4S3RRdWVTMmIySHJmM3Amc3RhdGU9eHl6",
        "output": "https://example.com/cb?code=[REDACTED]&state=xyz",
        "use_included_keywords": false
      }
    ],
    "negative": [
      {
        "description": "invalid pattern for Polar Authorization Code",
        "input_base64": "cmVkaXJlY3RfdXJpP2NvZGU9cG9sYXJfYWNfc2hvcnQ=",
        "rejected_by": "pattern",
        "use_included_keywords": false
      }
    ]
  },
