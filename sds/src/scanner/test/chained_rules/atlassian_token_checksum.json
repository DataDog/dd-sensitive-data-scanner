[
  {
    "id": "atlassian_api_token",
    "pattern": "\\bATATT3xFfGF0[A-Za-z0-9\\-_]{171}=[A-F0-9]{8}\\b",
    "default_included_keywords": [],
    "hand_written_validator": {
      "type": "AtlassianTokenChecksum"
    },
    "validator": {
      "type": "ChainedStepValidator",
      "default_response": "pass",
      "config": {
        "version": 1,
        "steps": [
          {
            "name": "prefix_and_suffix",
            "comment": "AtlassianTokenChecksum requires a non-empty prefix; the CRC covers it, `=` included",
            "op": "RegexMatch",
            "input": {
              "param": "$GLOBAL_MATCH",
              "pattern": "(?<prefix>[A-Za-z0-9_=-]+)(?<suffix>[0-9A-Fa-f]{8})"
            },
            "captures": {
              "prefix": "prefix",
              "suffix": "suffix"
            }
          },
          {
            "name": "verify",
            "op": "VerifyChecksum",
            "input": {
              "payload": "$prefix",
              "embedded": "$suffix",
              "alg": "crc32",
              "scheme": "hex"
            }
          }
        ]
      }
    },
    "positive": [
